# Copy this file to Backend/.env (it is in .gitignore). Vapor reads .env by itself on start.
# Your TMDB "API Read Access Token": themoviedb.org → Settings → API.
TMDB_TOKEN=paste-your-token-here
# Leave DATABASE_URL empty locally: the server then uses a db.sqlite file.
# DATABASE_URL=postgresql://user:password@host/lumikos?sslmode=require
